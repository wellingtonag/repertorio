# String de conexão do Neon (Dashboard Neon > Connect > copiar "Connection string")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Senha única do grupo para editar (adicionar, alterar, excluir)
EDIT_PASSWORD=troque-esta-senha

# Chave que assina o cookie de login (mínimo 16 caracteres, aleatória).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Spotify (opcional: sem isto o player aparece, mas a lista não sincroniza sozinha) ---
# Crie o app em https://developer.spotify.com/dashboard (Redirect URI: http://127.0.0.1:8888/callback)
SPOTIFY_CLIENT_ID=bd2973906c0a4711bef1545dda11fc09
SPOTIFY_CLIENT_SECRET=41a930e5327b4f809945d19de51f859c
# Gerado por: npm run spotify:auth
SPOTIFY_REFRESH_TOKEN=
# Opcional (padrão: a playlist atual)
# SPOTIFY_PLAYLIST_ID=1yNfq1mBmnzI0ZbrSenXbW
